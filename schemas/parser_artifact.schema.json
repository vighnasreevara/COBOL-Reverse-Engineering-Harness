{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parser manifest (stage 2)",
  "type": "object",
  "required": ["schema_version", "meta", "stats", "programs", "issues"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "meta": {
      "type": "object",
      "required": ["generator", "generator_version", "generated_at", "inventory", "inventory_sha256", "root"],
      "properties": {"generator": {"const": "harness.parser"}, "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "stats": {"type": "object", "required": ["programs", "programs_by_status", "paragraphs", "statements", "issues"]},
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "path", "kind", "status"],
        "properties": {
          "status": {"enum": ["parsed", "skipped", "failed"]},
          "output": {"type": "string"},
          "metrics": {"type": "object"}
        },
        "if": {"properties": {"status": {"const": "parsed"}}},
        "then": {"required": ["output", "metrics", "issues"]}
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "code", "message", "subject"],
        "properties": {"severity": {"enum": ["error", "warning", "info"]}, "subject": {"type": "string"}}
      }
    }
  }
}
